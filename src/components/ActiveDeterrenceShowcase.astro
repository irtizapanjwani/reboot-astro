---
// Component: ActiveDeterrenceShowcase.astro
---

<section class="py-20 bg-white dark:bg-slate-950 text-slate-900 dark:text-white relative overflow-hidden border-b border-slate-200/80 dark:border-white/10" id="active-deterrence">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 dark:bg-red-950/60 border border-red-300 dark:border-red-800/60 text-red-700 dark:text-red-300 text-xs font-bold uppercase tracking-wider shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
        <span>Proactive Crime Prevention</span>
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white uppercase leading-[1.1] font-display">
        The Best Crime Is The One <span class="text-red-600">That Never Happens.</span>
      </h2>

      <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed pt-1">
        Why just record a burglary? Standard cameras only give you a video of thieves who have already escaped with your valuables. Our <strong>Active Deterrence Cameras</strong> hit intruders with bright flashing red/blue police strobes and a 110dB siren the instant they step onto your boundary.
      </p>
    </div>

    <!-- HIGH-IMPACT COMMAND DECK STAGE -->
    <div class="relative rounded-3xl bg-slate-900 text-white p-8 sm:p-12 border border-slate-800 shadow-2xl overflow-hidden">
      
      <!-- Ambient Glow in Stage -->
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Flashing Voice Warning Alert Banner -->
      <div class="mb-10 text-center relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 border border-red-500/40 text-red-400 text-xs font-mono font-bold tracking-widest uppercase mb-2">
          <span>🚨 110dB Siren + Police Strobe Deterrent</span>
        </div>
        <p class="text-xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight text-red-500 font-display leading-tight">
          &ldquo;Warning: You are being recorded and police have been notified&rdquo;
        </p>
      </div>

      <!-- 3-Column Display: Left Specs, Center 3D Cameras, Right Specs -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <!-- Left 2 Features -->
        <div class="lg:col-span-3 space-y-6 text-center lg:text-left order-2 lg:order-1">
          <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700/80 backdrop-blur-sm space-y-2">
            <span class="text-xs font-mono font-black uppercase text-red-400 tracking-wider">01 // Active Strobes</span>
            <h3 class="text-lg font-bold text-white font-display">Red &amp; Blue Warning Flashes</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Alternating police strobes signal instant detection and eliminate night-time cover.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700/80 backdrop-blur-sm space-y-2">
            <span class="text-xs font-mono font-black uppercase text-amber-400 tracking-wider">02 // Audio Alarm</span>
            <h3 class="text-lg font-bold text-white font-display">Built-In 110dB Siren</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Loud audible siren or customized verbal commands scare away prowlers instantly.
            </p>
          </div>
        </div>

        <!-- Center 3D Camera Showcase -->
        <div class="lg:col-span-6 flex flex-col items-center justify-center order-1 lg:order-2 py-4">
          <div class="relative w-full max-w-sm sm:max-w-md">
            <div class="absolute inset-0 bg-radial from-red-600/20 via-blue-600/10 to-transparent rounded-full blur-2xl pointer-events-none"></div>
            
            <!-- Dahua TiOC Cameras with High Contrast against dark background -->
            <img 
              src="/dahua-tioc-cameras.png" 
              alt="Dahua TiOC active deterrence security camera in white and black with strobe and siren" 
              class="w-full h-auto object-contain relative z-10 drop-shadow-[0_20px_40px_rgba(0,0,0,0.8)] transform hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-slate-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>AI Perimeter Guard • 24/7 Armed</span>
          </div>
        </div>

        <!-- Right 2 Features -->
        <div class="lg:col-span-3 space-y-6 text-center lg:text-left order-3">
          <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700/80 backdrop-blur-sm space-y-2">
            <span class="text-xs font-mono font-black uppercase text-blue-400 tracking-wider">03 // Smart AI</span>
            <h3 class="text-lg font-bold text-white font-display">Human &amp; Vehicle Filter</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Eliminates false alarms from wind, rain, trees, and domestic pets.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700/80 backdrop-blur-sm space-y-2">
            <span class="text-xs font-mono font-black uppercase text-emerald-400 tracking-wider">04 // Two-Way Audio</span>
            <h3 class="text-lg font-bold text-white font-display">2-Way Speaker &amp; Mic</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Speak directly to delivery drivers or warn trespassers right from your phone.
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
