<script is:inline>
  function filterSuburbs(query) {
    const q = query.toLowerCase().trim();
    const pills = document.querySelectorAll('.suburb-pill');
    pills.forEach((pill) => {
      const text = pill.textContent.toLowerCase();
      if (!q || text.includes(q)) {
        pill.style.display = '';
      } else {
        pill.style.display = 'none';
      }
    });
  }
</script>
