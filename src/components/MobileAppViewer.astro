---
// Component: MobileAppViewer.astro
// Interactive Smartphone CCTV Monitoring HUD
// Full 4-Camera Switcher, AI Bounding Reticles, Day/Night ColorVu, and Active Deterrence Event
---

<section id="remote-viewing" class="py-20 relative overflow-hidden bg-slate-100/70 dark:bg-slate-900/50 border-y border-slate-200 dark:border-white/10 scroll-mt-24">
  <!-- Subtle Background Ambient Glows -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-red-600/10 dark:bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -right-20 w-96 h-96 bg-blue-600/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-black text-red-600 dark:text-red-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800/50 shadow-2xs">
        Live Mobile App &amp; Remote Viewing
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight font-display">
        Interactive Smartphone CCTV Monitoring
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
        Watch live incident feeds, receive instant push notifications when perimeters are breached, and experience full perimeter awareness right from your pocket.
      </p>
    </div>

    <!-- Main 2-Column Showcase Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Feature Highlights & Benefits (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-black uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Zero Monthly Subscription Fees • $0 Cloud Bills</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight leading-tight font-display">
          Total Perimeter Awareness Right from Your Pocket
        </h3>

        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          Every camera system we install in Brisbane includes complete mobile app setup on all household or staff phones and tablets. Watch crystal-clear live streams, receive instant push notifications, and retrieve recorded incident video in seconds.
        </p>

        <!-- Feature List -->
        <div class="space-y-6 pt-2">
          
          <!-- Feature 1 -->
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-red-50 dark:bg-red-950/60 border border-red-200/60 dark:border-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-base text-slate-900 dark:text-white font-display">Smart AI Human &amp; Vehicle Alerts</h4>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                Smart onboard algorithms ignore swaying trees, rain, and pets. You only get buzzed when a genuine person or vehicle enters your property.
              </p>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-red-50 dark:bg-red-950/60 border border-red-200/60 dark:border-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-base text-slate-900 dark:text-white font-display">Live 4K Multi-Screen Feeds &amp; Playback</h4>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                Monitor Driveway, Front Porch, and Backyard simultaneously. Scrub through recorded timelines in seconds and export clips straight to your camera roll.
              </p>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-red-50 dark:bg-red-950/60 border border-red-200/60 dark:border-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-base text-slate-900 dark:text-white font-display">Seamless Multi-Device Family Access</h4>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                Configured on all household iPhones, iPads, Androids, and PC/Macs. Free encrypted P2P streaming with zero monthly cloud subscriptions.
              </p>
            </div>
          </div>

        </div>

        <!-- CTA & Phone Hotline -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a href="#quote" onclick="prefillQuote('Remote Viewing Setup & Mobile App', 'Home / Residential')" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white text-center font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/25 transition-all">
            Get Free App Setup With Quote &rarr;
          </a>
          <a href="tel:+61731552002" class="px-5 py-3.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:border-red-500 text-slate-800 dark:text-slate-200 text-center font-bold text-xs flex items-center justify-center gap-2 transition-all">
            <span>📞 (07) 3155 2002</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Smartphone Mockup with 2-Slide View (lg:col-span-7) -->
      <div class="lg:col-span-7">
        <div class="relative mx-auto max-w-lg lg:max-w-xl group">
          
          <!-- Outer Ambient Color Glow -->
          <div class="absolute -inset-2 bg-gradient-to-r from-red-600/20 via-blue-600/20 to-red-500/20 rounded-[36px] blur-xl opacity-80 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

          <!-- Slide Navigation Tabs (Live Camera Feeds vs Active Deterrence Event) -->
          <div class="relative z-20 flex items-center justify-between p-1.5 rounded-2xl bg-slate-900/95 border border-white/15 mb-3 shadow-xl backdrop-blur-md">
            <button 
              type="button" 
              id="tab-slide-live" 
              onclick="switchAppViewerSlide('live')" 
              class="flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 bg-red-600 text-white shadow-md cursor-pointer"
            >
              <span>📹 4K Camera Feeds</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-red-950/80 text-red-200 hidden sm:inline">Interactive</span>
            </button>
            <button 
              type="button" 
              id="tab-slide-deterrence" 
              onclick="switchAppViewerSlide('deterrence')" 
              class="flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white cursor-pointer"
            >
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span>🚨 Siren &amp; Strobes Event</span>
            </button>
          </div>

          <!-- Luminous Framed Phone Housing -->
          <div class="relative rounded-[32px] sm:rounded-[36px] p-2 sm:p-2.5 bg-slate-950 border-2 border-slate-700/80 shadow-2xl">
            
            <!-- ============================================== -->
            <!-- SLIDE 1: MAIN INTERACTIVE LIVE CAMERA APPS HUD -->
            <!-- ============================================== -->
            <div id="app-slide-live" class="min-h-[530px] sm:min-h-[550px] flex flex-col justify-between gap-2.5 transition-opacity duration-300">
              
              <!-- OSD Live Status Header -->
              <div class="h-12 px-4 py-2.5 rounded-2xl bg-slate-900/90 border border-white/10 flex items-center justify-between gap-2 shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-3 h-3 rounded-full bg-red-600 animate-pulse shrink-0"></span>
                  <span id="cam-active-title" class="font-black text-white text-xs sm:text-sm tracking-wide truncate font-mono">
                    CAM 01 • DRIVEWAY &amp; FRONT ENTRY
                  </span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[11px] shrink-0">
                  <span class="px-2.5 py-1 rounded-md bg-red-600/30 text-red-300 border border-red-500/40 font-bold">4K UHD</span>
                  <span class="px-2.5 py-1 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold flex items-center gap-1">
                    <span>REC</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  </span>
                </div>
              </div>

              <!-- Central Video Stage Screen -->
              <div 
                id="cctv-preview-screen" 
                class="relative flex-1 min-h-[290px] sm:min-h-[310px] w-full bg-slate-950 bg-cover bg-center overflow-hidden border border-white/10 rounded-2xl flex items-center justify-center p-3 select-none"
                style="background-image: linear-gradient(rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.35)), url('/cctv-ch1-day.jpg');"
              >
                <!-- Scanline Overlay -->
                <div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px]"></div>

                <!-- AI Bounding Reticle Box (Only Retained Element On Screen) -->
                <div id="cctv-target-box" class="relative z-10 w-44 sm:w-52 h-28 sm:h-32 border-2 border-dashed border-red-400 rounded-xl flex flex-col justify-between p-2 bg-red-500/10 backdrop-blur-[1px] transition-all pointer-events-none">
                  <div class="flex justify-between text-[8px] sm:text-[9px] font-mono font-bold text-red-300">
                    <span id="ai-box-conf">98.4% CONF</span>
                    <span id="ai-box-target">TARGET: VEHICLE</span>
                  </div>
                  <div id="ai-box-zone" class="text-[9px] sm:text-[10px] font-mono font-black text-white uppercase bg-black/80 px-2.5 py-1 rounded mx-auto border border-red-400/40">
                    Front Driveway Zone
                  </div>
                </div>
              </div>

              <!-- Multi-Camera Channel Switcher Buttons -->
              <div class="h-12 bg-slate-900/90 px-4 py-2 border border-white/10 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-mono font-bold shrink-0">
                <span class="text-slate-400 text-xs tracking-wider uppercase font-extrabold">SWITCH CAM:</span>
                <div class="grid grid-cols-4 gap-2 w-full sm:w-auto">
                  <button 
                    type="button" 
                    onclick="switchCamera(1, 'CAM 01 • DRIVEWAY & FRONT ENTRY', 'AI ACUSENSE: VEHICLE')" 
                    id="cam-btn-1" 
                    class="px-3.5 py-1.5 rounded-xl bg-red-600 text-white transition-all text-center text-xs font-mono font-bold shadow-md cursor-pointer"
                  >
                    CH 1
                  </button>
                  <button 
                    type="button" 
                    onclick="switchCamera(2, 'CAM 02 • PORCH & PACKAGE DROP', 'FACIAL DETECTION: RECOGNISED')" 
                    id="cam-btn-2" 
                    class="px-3.5 py-1.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-xs font-mono font-bold cursor-pointer"
                  >
                    CH 2
                  </button>
                  <button 
                    type="button" 
                    onclick="switchCamera(3, 'CAM 03 • SIDE PASSAGEWAY', 'PERIMETER LINE CROSS')" 
                    id="cam-btn-3" 
                    class="px-3.5 py-1.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-xs font-mono font-bold cursor-pointer"
                  >
                    CH 3
                  </button>
                  <button 
                    type="button" 
                    onclick="switchCamera(4, 'CAM 04 • REAR ENTERTAINING', 'MOTION: PATIO CLEAR')" 
                    id="cam-btn-4" 
                    class="px-3.5 py-1.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-xs font-mono font-bold cursor-pointer"
                  >
                    CH 4
                  </button>
                </div>
              </div>

              <!-- Day / ColorVu Night Vision Mode Controls -->
              <div class="h-14 bg-slate-900/90 px-4 py-2 rounded-2xl border border-white/10 flex items-center justify-between gap-3 shrink-0">
                <div class="text-xs">
                  <div class="font-black text-white text-sm flex items-center gap-1.5">
                    <span>Night Vision Demo:</span>
                    <span class="text-xs text-red-400 font-bold">Try ColorVu</span>
                  </div>
                  <div class="text-xs text-slate-400 mt-0.5">See real sensor low-light clarity</div>
                </div>

                <div class="flex items-center gap-1.5 bg-slate-950 p-1 rounded-xl border border-white/10 shrink-0">
                  <button 
                    type="button" 
                    id="btn-day" 
                    onclick="setCctvVision('day')" 
                    class="w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold bg-red-600 text-white transition-all cursor-pointer shadow-md flex items-center justify-center gap-1"
                  >
                    <span>☀️ Day</span>
                  </button>
                  <button 
                    type="button" 
                    id="btn-night" 
                    onclick="setCctvVision('night')" 
                    class="w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all cursor-pointer flex items-center justify-center gap-1"
                  >
                    <span>🌙 ColorVu</span>
                  </button>
                </div>
              </div>

            </div>

            <!-- ========================================================================= -->
            <!-- SLIDE 2: ACTIVE DETERRENCE EVENT (EXACT SAME HEIGHT AS SLIDE 1)           -->
            <!-- ========================================================================= -->
            <div id="app-slide-deterrence" class="hidden min-h-[530px] sm:min-h-[550px] flex flex-col justify-between gap-2.5 transition-opacity duration-300">
              
              <!-- Strobe Police Header with Alternating Blue & Red Beacons -->
              <div class="h-12 police-glow-box px-4 py-2.5 rounded-2xl bg-slate-900/95 border-2 border-red-500/60 flex items-center justify-between gap-2 shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-3.5 h-3.5 rounded-full bg-red-600 animate-strobe-red shadow-lg shadow-red-600/80 shrink-0"></span>
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-600 animate-strobe-blue shadow-lg shadow-blue-600/80 shrink-0"></span>
                  <span class="font-mono font-black text-white text-xs sm:text-sm tracking-wide uppercase truncate">
                    ACTIVE DETERRENCE IN PROGRESS
                  </span>
                </div>
                <span class="px-2.5 py-1 rounded-md bg-red-500/20 text-red-400 border border-red-500/40 text-[10px] sm:text-[11px] font-mono font-bold uppercase animate-pulse shrink-0">
                  Strobes ON
                </span>
              </div>

              <!-- Central Screen (Cameras That Fight Back GIF) -->
              <div class="relative flex-1 min-h-[380px] sm:min-h-[400px] w-full bg-slate-950 overflow-hidden border border-white/10 rounded-2xl flex items-center justify-center select-none p-1.5">
                <img 
                  src="/cameras-that-fight-back.gif" 
                  alt="Cameras That Fight Back - Sound and Light Alarm Dahua WizSense Active Deterrence" 
                  class="w-full h-full max-h-[390px] aspect-square object-contain mx-auto"
                  loading="lazy"
                />
              </div>

              <!-- Bottom Specs & Return to Live Feeds Strip -->
              <div class="h-14 bg-slate-900/90 px-4 py-2 rounded-2xl border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-mono shrink-0">
                <div class="text-slate-300 flex flex-wrap items-center gap-2 text-[11px]">
                  <span class="text-emerald-400 font-bold">✓ Instant Push Sent</span>
                  <span class="text-slate-600">•</span>
                  <span>110dB Siren</span>
                  <span class="text-slate-600">•</span>
                  <span class="text-red-400 font-bold">Flashing Strobes</span>
                </div>
                <button 
                  type="button" 
                  onclick="switchAppViewerSlide('live')" 
                  class="px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider transition-all cursor-pointer shadow-md flex items-center justify-center gap-1.5 shrink-0"
                >
                  <span>📹 Live Feeds &rarr;</span>
                </button>
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Custom Keyframes for Flashing Blue and Red Police Strobes -->
<style>
  @keyframes police-strobe-red {
    0%, 20%, 40% { 
      opacity: 1; 
      filter: drop-shadow(0 0 14px #ef4444); 
      transform: scale(1.15); 
    }
    10%, 30%, 50%, 100% { 
      opacity: 0.25; 
      filter: none; 
      transform: scale(1); 
    }
  }

  @keyframes police-strobe-blue {
    0%, 50% { 
      opacity: 0.25; 
      filter: none; 
      transform: scale(1); 
    }
    60%, 80%, 100% { 
      opacity: 1; 
      filter: drop-shadow(0 0 14px #3b82f6); 
      transform: scale(1.15); 
    }
    70%, 90% { 
      opacity: 0.25; 
      transform: scale(1); 
    }
  }

  @keyframes police-border-glow {
    0%, 49% {
      box-shadow: 0 0 35px rgba(239, 68, 68, 0.45), inset 0 0 15px rgba(239, 68, 68, 0.25);
      border-color: rgba(239, 68, 68, 0.7);
    }
    50%, 100% {
      box-shadow: 0 0 35px rgba(59, 130, 246, 0.45), inset 0 0 15px rgba(59, 130, 246, 0.25);
      border-color: rgba(59, 130, 246, 0.7);
    }
  }

  .animate-strobe-red {
    animation: police-strobe-red 0.85s infinite ease-in-out;
  }

  .animate-strobe-blue {
    animation: police-strobe-blue 0.85s infinite ease-in-out;
  }

  .police-glow-box {
    animation: police-border-glow 0.85s infinite;
  }
</style>

<!-- Slide & Camera Switcher Script -->
<script is:inline>
  const cameraFeeds = {
    1: {
      day: '/cctv-ch1-day.jpg',
      night: '/cctv-ch1-night.jpg',
      boxStyle: 'w-44 sm:w-52 h-28 sm:h-32 border-2 border-dashed border-red-400 rounded-xl mx-auto relative flex flex-col justify-between p-2 bg-red-500/10 backdrop-blur-[1px] transition-all',
      boxConf: '98.4% CONF',
      boxTarget: 'TARGET: VEHICLE',
      boxZone: 'Front Driveway Zone'
    },
    2: {
      day: '/cctv-ch2-porch.jpg',
      night: '/cctv-ch2-porch.jpg',
      boxStyle: 'w-36 sm:w-44 h-28 sm:h-32 border-2 border-dashed border-emerald-400 rounded-xl mx-auto relative flex flex-col justify-between p-2 bg-emerald-500/10 backdrop-blur-[1px] transition-all',
      boxConf: '99.1% CONF',
      boxTarget: 'PACKAGE DROP',
      boxZone: 'Porch Parcel Area'
    },
    3: {
      day: '/cctv-ch3-side.jpg',
      night: '/cctv-ch3-side.jpg',
      boxStyle: 'w-40 sm:w-48 h-32 sm:h-36 border-2 border-dashed border-amber-400 rounded-xl mx-auto relative flex flex-col justify-between p-2 bg-amber-500/10 backdrop-blur-[1px] transition-all',
      boxConf: 'PERIMETER OK',
      boxTarget: 'FENCE LINE',
      boxZone: 'Side Passageway'
    },
    4: {
      day: '/cctv-ch4-patio.jpg',
      night: '/cctv-ch4-patio.jpg',
      boxStyle: 'w-44 sm:w-52 h-28 sm:h-32 border-2 border-dashed border-blue-400 rounded-xl mx-auto relative flex flex-col justify-between p-2 bg-blue-500/10 backdrop-blur-[1px] transition-all',
      boxConf: 'MOTION CLEAR',
      boxTarget: 'PATIO ZONE',
      boxZone: 'Rear Alfresco'
    }
  };

  let currentChannel = 1;
  let currentVisionMode = 'day';

  function updateCameraDisplay() {
    const screen = document.getElementById('cctv-preview-screen');
    const feed = cameraFeeds[currentChannel];
    if (!screen || !feed) return;

    const bgImg = currentVisionMode === 'night' ? feed.night : feed.day;
    screen.style.backgroundImage = 'linear-gradient(rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.35)), url("' + bgImg + '")';

    const box = document.getElementById('cctv-target-box');
    const conf = document.getElementById('ai-box-conf');
    const target = document.getElementById('ai-box-target');
    const zone = document.getElementById('ai-box-zone');

    if (box && feed.boxStyle) box.className = feed.boxStyle;
    if (conf && feed.boxConf) conf.textContent = feed.boxConf;
    if (target && feed.boxTarget) target.textContent = feed.boxTarget;
    if (zone && feed.boxZone) zone.textContent = feed.boxZone;
  }

  function switchCamera(channelNum, title, detectionText) {
    currentChannel = channelNum;
    const titleEl = document.getElementById('cam-active-title');
    if (titleEl) titleEl.textContent = title;
    
    for (let i = 1; i <= 4; i++) {
      const btn = document.getElementById('cam-btn-' + i);
      if (btn) {
        if (i === channelNum) {
          btn.className = 'px-3.5 py-1.5 rounded-xl bg-red-600 text-white transition-all text-center text-xs font-mono font-bold shadow-md cursor-pointer';
        } else {
          btn.className = 'px-3.5 py-1.5 rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-xs font-mono font-bold cursor-pointer';
        }
      }
    }

    updateCameraDisplay();
  }

  function setCctvVision(mode) {
    currentVisionMode = mode;
    const btnDay = document.getElementById('btn-day');
    const btnNight = document.getElementById('btn-night');

    if (mode === 'night') {
      if (btnNight) btnNight.className = 'w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold bg-red-600 text-white transition-all cursor-pointer shadow-md flex items-center justify-center gap-1';
      if (btnDay) btnDay.className = 'w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all cursor-pointer flex items-center justify-center gap-1';
    } else {
      if (btnDay) btnDay.className = 'w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold bg-red-600 text-white transition-all cursor-pointer shadow-md flex items-center justify-center gap-1';
      if (btnNight) btnNight.className = 'w-24 sm:w-28 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all cursor-pointer flex items-center justify-center gap-1';
    }

    updateCameraDisplay();
  }

  function switchAppViewerSlide(mode) {
    const liveSlide = document.getElementById('app-slide-live');
    const deterrenceSlide = document.getElementById('app-slide-deterrence');
    const tabLive = document.getElementById('tab-slide-live');
    const tabDeterrence = document.getElementById('tab-slide-deterrence');

    if (mode === 'deterrence') {
      if (liveSlide) liveSlide.classList.add('hidden');
      if (deterrenceSlide) deterrenceSlide.classList.remove('hidden');
      if (tabLive) {
        tabLive.className = 'flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white cursor-pointer';
      }
      if (tabDeterrence) {
        tabDeterrence.className = 'flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 bg-gradient-to-r from-red-600 to-blue-600 text-white shadow-md cursor-pointer animate-pulse';
      }
    } else {
      if (deterrenceSlide) deterrenceSlide.classList.add('hidden');
      if (liveSlide) liveSlide.classList.remove('hidden');
      if (tabLive) {
        tabLive.className = 'flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 bg-red-600 text-white shadow-md cursor-pointer';
      }
      if (tabDeterrence) {
        tabDeterrence.className = 'flex-1 py-2.5 px-2.5 sm:px-3 rounded-xl text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white cursor-pointer';
      }
      updateCameraDisplay();
    }
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    updateCameraDisplay();
  });
</script>
