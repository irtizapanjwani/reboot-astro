---
// Component: MasterCablerSection.astro
import { business } from '../config/business';
---

<section class="py-16 lg:py-20 relative overflow-hidden bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200/80 dark:border-white/10" id="master-cabler-hookup">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Rack Image Card -->
      <div class="lg:col-span-5 order-last lg:order-first">
        <div class="relative mx-auto max-w-md lg:max-w-none group">
          <div class="relative rounded-3xl p-2 bg-white dark:bg-slate-800 border border-slate-200/90 dark:border-white/15 shadow-xl shadow-slate-200/70 dark:shadow-black/60 transition-all duration-500">
            <div class="relative rounded-2xl overflow-hidden aspect-[941/1200] bg-slate-950">
              <img 
                src="/cctv-slide2.jpg" 
                alt="Professional wall-mounted network rack with immaculate Cat6 Ethernet cabling and NVR hookup" 
                class="w-full h-full object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
                loading="lazy"
              />

              <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-900/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold flex items-center gap-1.5 shadow-lg z-10">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Licensed ACMA Cabler</span>
              </div>

              <div class="absolute bottom-3 inset-x-3 p-3.5 rounded-xl bg-slate-950/90 backdrop-blur-md border border-white/15 text-white flex items-center justify-between shadow-xl z-10">
                <div>
                  <div class="text-xs sm:text-sm font-black tracking-tight text-white font-display">
                    Certified Cat6 Data Termination
                  </div>
                  <p class="text-[11px] text-slate-300 mt-0.5">Tidy patch panels • Concealed wiring • Lifetime guarantee</p>
                </div>
                <span class="px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-red-600 text-white text-center leading-tight">
                  ACMA<br/>Open
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Content -->
      <div class="lg:col-span-7 space-y-6 order-first lg:order-last">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300 text-xs font-black uppercase tracking-wider shadow-2xs">
          <span>⚡</span>
          <span>ACMA CABLER • LICENSED QLD SECURITY • SAVE UP TO 50%</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1] font-display">
          You Don't Need an Electrician <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 via-orange-600 to-red-600">for IP Camera Systems.</span>
        </h2>

        <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
          IP security cameras run on low-voltage 48V Power-over-Ethernet (PoE), not 240V mains power. As a licensed ACMA Master Cabler and computer technician, I handle the clean in-roof Cat6 cabling, firewall configuration, NVR recorder setup, and smartphone app setup &ndash; often at half the rate charged by general electricians.
        </p>

        <div class="space-y-3 pt-1 text-sm sm:text-base text-slate-700 dark:text-slate-200 font-semibold">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>Licensed ACMA Open Master Cabler &amp; QLD Security Provider</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>Complete Network Router, Firewall &amp; Multi-Device App Configuration</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>100% Solid Copper Cat6 / Cat6A Low-Voltage PoE Cabling</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span>Flat $150/hr Transparent Rate • Zero Call-Out Fees Across Brisbane</span>
          </div>
        </div>

        <div class="pt-3 flex flex-wrap items-center gap-4">
          <a href="#quote" class="px-8 py-4 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/25 inline-flex items-center gap-2 transform hover:-translate-y-0.5 transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Request a Cabling Quote
          </a>

          <a href={business.phoneHref} class="px-6 py-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-slate-800 dark:text-white hover:border-red-500 font-bold text-xs uppercase tracking-wider shadow-2xs transition-all inline-flex items-center gap-2">
            <span>Call {business.phone}</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
