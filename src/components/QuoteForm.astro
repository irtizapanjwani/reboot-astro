---
// Component: QuoteForm.astro
import { business } from '../config/business';
---

<!-- FINAL CONVERSION BLOCK: REQUEST A SECURITY QUOTE -->
<section id="quote" class="py-20 relative overflow-hidden scroll-mt-24 bg-slate-50 dark:bg-slate-900/60 border-t border-slate-200 dark:border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="glass-box rounded-3xl p-8 sm:p-12 border-2 border-slate-200 dark:border-white/15 relative overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Info Column -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-black text-red-600 dark:text-red-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800/50">
            Direct Technician Dispatch
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight font-display">
            Request a Security Quote
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
            Get an itemized written quote for CCTV installation, network cabling, or security upgrades across Brisbane. No hidden travel fees, no sales pressure.
          </p>

          <!-- Inclusions Checklist -->
          <ul class="space-y-3 text-sm sm:text-base text-slate-700 dark:text-slate-300 pt-2 border-t border-slate-200 dark:border-white/10">
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Zero obligation:</strong> Free detailed written proposal with zero sales pressure.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Fixed written scope:</strong> Itemized hardware, storage, and Cat6 cabling breakdown.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span><strong>Transparent warranties:</strong> 3-Yr equipment and 5-Yr workmanship guarantees.</span>
            </li>
            <li class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span><strong>No call out fees:</strong> Honest flat /hr rate with no travel surcharges.</span>
            </li>
          </ul>

          <div class="p-4 rounded-2xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/50 text-sm sm:text-base text-slate-700 dark:text-slate-300">
            Prefer to speak with us right now? Call our technician directly: <br>
            <a href={business.phoneHref} class="text-red-600 dark:text-red-400 font-black text-base sm:text-lg block mt-1">{business.phone}</a>
            <span class="text-xs text-slate-500 dark:text-slate-400 block mt-0.5">{business.phoneNote}</span>
          </div>
        </div>

        <!-- Right Interactive Form Column (Web3Forms API Backend) -->
        <div class="lg:col-span-7">
          
          <!-- Web3Forms Powered Form -->
          <form 
            action={business.formAction} 
            method="POST" 
            id="cctv-quote-form" 
            class="space-y-4 transition-opacity duration-300"
          >
            <!-- Required Web3Forms Access Key -->
            <input type="hidden" name="access_key" value={business.web3formsAccessKey} />
            
            <!-- Metadata & Anti-Spam Fields -->
            <input type="hidden" name="subject" value="New Computer &amp; Network Security Quote Request - rebootyourcomputer.com.au" />
            <input type="hidden" name="from_name" value="Reboot Security Web Leads" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <!-- Row 1: Name & Suburb -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-name">Your Name *</label>
                <input type="text" required id="form-name" name="name" placeholder="e.g. David Lin" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-4 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors" />
              </div>

              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-suburb">Suburb / Postcode *</label>
                <input type="text" required id="form-suburb" name="suburb" placeholder="e.g. Chermside 4032" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-4 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors" />
              </div>
            </div>

            <!-- Row 2: Email & Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-email">Email Address *</label>
                <input type="email" required id="form-email" name="email" placeholder="e.g. name@example.com" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-4 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors" />
              </div>

              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-phone">Phone / Mobile Contact *</label>
                <input type="tel" required id="form-phone" name="phone" placeholder="e.g. 0400 000 000" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-4 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors" />
              </div>
            </div>

            <!-- Row 3: Property Type & Service -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-property">Property Type</label>
                <select id="form-property" name="propertyType" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-3.5 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors">
                  <option value="Home / Residential">Home / Residential</option>
                  <option value="Commercial Business">Commercial Business / Retail</option>
                  <option value="Warehouse / Industrial">Warehouse / Industrial</option>
                  <option value="Body Corporate / Strata">Body Corporate / Strata</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-service">Service Required</label>
                <select id="form-service" name="serviceType" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-3.5 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors">
                  <option value="New Complete CCTV System">New Complete CCTV System (4K PoE)</option>
                  <option value="Computer & Network Security">Computer &amp; Network Security / Firewall</option>
                  <option value="Data & Ethernet Cabling">Data &amp; Ethernet Cabling Setup</option>
                  <option value="Active Deterrence CCTV">Active Deterrence AI Camera System</option>
                  <option value="BYO Camera Installation">BYO (Customer Supplied) Cameras</option>
                  <option value="CCTV Repair or Upgrade">Repair Dead / Offline System</option>
                </select>
              </div>
            </div>

            <!-- Row 4: Camera Count & Storeys -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-cameras">Estimated Camera Count</label>
                <select id="form-cameras" name="cameraCount" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-3.5 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors">
                  <option value="4 Cameras (Standard Home)">4 Cameras (Standard Home)</option>
                  <option value="6 Cameras (Large Home / Corner)">6 Cameras (Large Home / Corner)</option>
                  <option value="8 Cameras (Commercial / Acreage)">8 Cameras (Commercial / Acreage)</option>
                  <option value="12+ Cameras (Commercial Enterprise)">12+ Cameras (Commercial Enterprise)</option>
                  <option value="Not Sure - Need Recommendation">Not Sure - Need Recommendation</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-storeys">Building Layout</label>
                <select id="form-storeys" name="buildingStoreys" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-3.5 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors">
                  <option value="Single Storey (Standard Access)">Single Storey (Standard Access)</option>
                  <option value="Double Storey">Double Storey</option>
                  <option value="Split Level / Highset">Split Level / Highset</option>
                  <option value="Commercial Suspended Ceiling">Commercial Suspended Ceiling</option>
                  <option value="Commercial Warehouse High Bay">Commercial Warehouse High Bay</option>
                </select>
              </div>
            </div>

            <!-- Message / Notes -->
            <div>
              <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5" for="form-notes">Project Details / Specific Goals</label>
              <textarea id="form-notes" name="message" rows="3" placeholder="Tell us about your property, problem areas (e.g. driveway, back yard), or existing cabling..." class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-white/15 rounded-xl px-4 py-3 text-sm sm:text-base text-slate-900 dark:text-white focus:outline-none focus:border-red-500 transition-colors"></textarea>
            </div>

            <!-- Submit Button & Disclaimer -->
            <div class="pt-2">
              <button 
                type="submit" 
                id="submit-button" 
                class="w-full py-4 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-600 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-red-600/30 transition-all cursor-pointer flex items-center justify-center gap-2 transform hover:-translate-y-0.5"
              >
                <span id="button-text">Send Free Quote Request</span>
                <span id="button-spinner" class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
              </button>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 text-center mt-2.5">
                🔒 We respect your privacy. No spam. Fast reply from a licensed Brisbane technician.
              </p>
            </div>
          </form>

          <!-- Success Modal / Overlay -->
          <div id="quote-success-msg" class="hidden p-8 rounded-3xl bg-emerald-50 dark:bg-emerald-950/60 border-2 border-emerald-500 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto text-3xl">
              ✓
            </div>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white font-display">Quote Request Received!</h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-md mx-auto leading-relaxed">
              Thank you! Your property information has been sent directly to our licensed Brisbane installation team. We will review your requirements and be in touch shortly.
            </p>
            <div class="pt-2">
              <a href={business.phoneHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 text-white font-bold text-xs uppercase tracking-wider">
                <span>Direct Call: {business.phone}</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<!-- Web3Forms Native Asynchronous Submission Script -->
<script is:inline>
  const quoteForm = document.getElementById('cctv-quote-form');
  const quoteSuccessMsg = document.getElementById('quote-success-msg');
  const submitButton = document.getElementById('submit-button');
  const buttonText = document.getElementById('button-text');
  const buttonSpinner = document.getElementById('button-spinner');

  if (quoteForm) {
    quoteForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      if (buttonText && buttonSpinner) {
        buttonText.textContent = 'Submitting Request...';
        buttonSpinner.classList.remove('hidden');
        submitButton.disabled = true;
      }

      const formData = new FormData(quoteForm);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          quoteForm.classList.add('hidden');
          if (quoteSuccessMsg) {
            quoteSuccessMsg.classList.remove('hidden');
            quoteSuccessMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } else {
          alert('Submission error: ' + (result.message || 'Please check your inputs and try again.'));
          if (buttonText && buttonSpinner) {
            buttonText.textContent = 'Send Free Quote Request';
            buttonSpinner.classList.add('hidden');
            submitButton.disabled = false;
          }
        }
      } catch (err) {
        alert('Network connection error. Please call us directly on (07) 3155 2002.');
        if (buttonText && buttonSpinner) {
          buttonText.textContent = 'Send Free Quote Request';
          buttonSpinner.classList.add('hidden');
          submitButton.disabled = false;
        }
      }
    });
  }
</script>
