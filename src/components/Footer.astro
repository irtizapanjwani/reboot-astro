---
// Component: Footer.astro
import { business } from '../config/business';
---

<footer class="bg-slate-100 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm sm:text-base border-t border-slate-300/80 dark:border-slate-800 pt-16 pb-24 sm:pb-16 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-300/80 dark:border-slate-800">
      
      <!-- Col 1: Business Summary & Service Area -->
      <div class="space-y-4">
        <a href="/" class="flex flex-col group py-1" aria-label="Reboot Computer Repairs">
          <span class="text-xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-1 font-display">
            <span>Reboot</span>
            <span class="text-red-600">Security</span>
          </span>
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            Computer &amp; Network Security Brisbane
          </span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed text-sm sm:text-base">
          Commercial-grade hardwired CCTV security camera systems, firewalls, and Cat6 network cabling for homes and commercial premises across Brisbane, Logan, Ipswich, Moreton Bay, and Redlands.
        </p>
        <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-mono">
          QLD Security Licence • ACMA Open Registered Cabler
        </div>
        <div class="pt-1">
          <div class="text-xs text-slate-500 dark:text-slate-400 uppercase font-bold tracking-wider">Direct Dispatch Phone:</div>
          <a href={business.phoneHref} class="text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 font-extrabold text-base sm:text-lg block mt-0.5 font-display">{business.phone}</a>
          <span class="text-xs text-slate-500 dark:text-slate-400">{business.phoneNote}</span>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4 text-sm sm:text-base font-display">Security Services</h4>
        <ul class="space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          <li><a href="#services" class="hover:text-red-600 dark:hover:text-white transition-colors">Home CCTV Installation</a></li>
          <li><a href="#services" class="hover:text-red-600 dark:hover:text-white transition-colors">Commercial Business Security</a></li>
          <li><a href="#services" class="hover:text-red-600 dark:hover:text-white transition-colors">Network Firewalls &amp; Routers</a></li>
          <li><a href="/data-ethernet-installation/" class="hover:text-red-600 dark:hover:text-white transition-colors">Data &amp; Ethernet Cabling</a></li>
          <li><a href="#active-deterrence" class="hover:text-red-600 dark:hover:text-white transition-colors">Active Deterrence &amp; Sirens</a></li>
          <li><a href="/services/" class="hover:text-red-600 dark:hover:text-white transition-colors">All Computer Repairs &amp; IT</a></li>
        </ul>
      </div>

      <!-- Col 3: Information -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4 text-sm sm:text-base font-display">Information &amp; Advice</h4>
        <ul class="space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          <li><a href="#pricing" class="hover:text-red-600 dark:hover:text-white transition-colors">CCTV Packages &amp; Pricing</a></li>
          <li><a href="#comparison" class="hover:text-red-600 dark:hover:text-white transition-colors">PoE vs Wireless Advice</a></li>
          <li><a href="#projects" class="hover:text-red-600 dark:hover:text-white transition-colors">Recent Brisbane Projects</a></li>
          <li><a href="#faqs" class="hover:text-red-600 dark:hover:text-white transition-colors">Security Installation FAQs</a></li>
          <li><a href="/about/" class="hover:text-red-600 dark:hover:text-white transition-colors">About Reboot Computer Repairs</a></li>
        </ul>
      </div>

      <!-- Col 4: Business & Legal -->
      <div>
        <h4 class="font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-4 text-sm sm:text-base font-display">Hours &amp; Coverage</h4>
        <ul class="space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          <li class="font-semibold text-slate-800 dark:text-slate-200">{business.hours.summary}</li>
          <li>Email: <a href={'mailto:' + business.email} class="text-red-600 dark:text-red-400 hover:underline">{business.email}</a></li>
          <li>Service Areas: Brisbane, Logan, Ipswich, Moreton Bay, Redlands</li>
          <li class="pt-2 text-emerald-600 dark:text-emerald-400 font-bold">✓ Zero Call Out Fees</li>
          <li class="text-red-600 dark:text-red-400 font-bold">✓ 5-Year Workmanship Warranty</li>
        </ul>
      </div>

    </div>

    <!-- Bottom Suburb Tags & Legal -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm sm:text-base text-slate-500 dark:text-slate-400">
      <div>
        &copy; {new Date().getFullYear()} {business.name}. Brisbane, Queensland, Australia.
      </div>
      <div class="flex items-center gap-4 text-sm sm:text-base">
        <a href={business.phoneHref} class="text-red-600 dark:text-red-400 font-bold hover:underline font-display">{business.phone}</a>
        <span>|</span>
        <a href="/privacy/" class="hover:underline">Privacy Policy</a>
      </div>
    </div>

  </div>
</footer>

<!-- MOBILE STICKY FLOATING QUICK CALL DOCK -->
<div class="fixed bottom-0 left-0 right-0 z-40 p-3 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border-t border-slate-200 dark:border-white/10 sm:hidden flex items-center gap-2 shadow-2xl">
  <a href={business.phoneHref} class="flex-1 py-3.5 rounded-xl bg-gradient-to-r from-red-600 to-red-500 text-white font-black text-sm flex items-center justify-center gap-2 shadow-lg shadow-red-600/25 transition-all">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
    Call {business.phone}
  </a>
  <a href="#quote" class="flex-1 py-3.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-black text-sm flex items-center justify-center gap-1 shadow-md transition-all">
    Request Quote
  </a>
</div>
