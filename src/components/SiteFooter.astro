---
// Site-wide footer for pages using Layout.astro. The skyline is Brisbane in
// line art (Wheel of Brisbane, City Hall, the CBD, Story Bridge, the river),
// stroked in the brand red-to-blue gradient. Facts come from business.ts.
import { business } from '../config/business';
import PhoneMark from './PhoneMark.astro';

const services = [
  'Virus & Malware Removal',
  'Data Recovery',
  'Hardware Repair',
  'Computer Setup',
];
const year = new Date().getFullYear();
