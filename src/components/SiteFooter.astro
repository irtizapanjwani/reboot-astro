  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="word">Reboot Your Computer</span>
        <span class="tagline">Fast Repairs Brisbane</span>
      </a>
      <p>On-site computer, Mac and laptop repairs across Greater Brisbane. No call-out fee, and no fix, no fee.</p>
      <p class="footer-contact">
        <a href={business.phoneHref} class="footer-phone"><PhoneMark /><span>{business.phone}</span></a>
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
    </div>

    <div>
      <h2 class="footer-head">Services</h2>
      <ul class="footer-list">
        {services.map((s) => <li><a href="/services/">{s}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-head">Areas we service</h2>
      <ul class="footer-list footer-areas">
        {business.areasServed.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-head">Opening hours</h2>
      <p class="footer-hours"><strong>Every day</strong>7AM &ndash; 10PM</p>
      <p class="footer-note">Including weekends and public holidays.</p>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {year} {business.name}. Brisbane, Australia.</p>
    <nav aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
    </nav>
  </div>
</footer>
