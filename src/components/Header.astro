---
// Component: Header.astro
// Exact replica of the official Reboot Your Computer (rebootyourcomputer.com.au) header
import { business } from '../config/business';
---

<header class="site-header bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex items-center justify-between gap-4">
    
    <!-- Brand Wordmark & Tagline -->
    <a href="/" class="flex flex-col group text-decoration-none" aria-label="Reboot Your Computer">
      <span class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-display">
        Reboot Your Computer
      </span>
      <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold mt-0.5">
        Fast Repairs Brisbane
      </span>
    </a>

    <!-- Official Main Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-9 text-[0.95rem] font-medium text-slate-700 dark:text-slate-200">
      <a href="/" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Home</a>
      <a href="/services/" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Services</a>
      <a href="/about/" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">About</a>
      <a href="/contact/" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Contact</a>
    </nav>

    <!-- Header Actions (Phone & Contact CTA) -->
    <div class="flex items-center gap-3 sm:gap-5">
      
      <!-- Phone Link (from global.css: .phone-link) -->
      <a 
        href={business.phoneHref} 
        class="hidden lg:flex items-center gap-1.5 text-[0.95rem] font-semibold text-red-600 dark:text-red-400 hover:underline whitespace-nowrap"
      >
        <svg class="w-4 h-4 text-red-600 dark:text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        <span>{business.phone}</span>
      </a>

      <!-- Primary CTA: Contact Us (matching .btn-primary) -->
      <a 
        href="/contact/" 
        class="px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl font-semibold text-[0.95rem] text-white shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 whitespace-nowrap"
        style="background: linear-gradient(135deg, #DC2626 0%, #EA580C 100%);"
      >
        Contact Us
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        onclick="toggleNavMenu()" 
        class="p-2 sm:p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 md:hidden cursor-pointer hover:bg-slate-200 transition-colors"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="site-nav-mobile" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-5 space-y-4 shadow-xl">
    <div class="flex flex-col space-y-3 text-base font-semibold text-slate-800 dark:text-slate-200">
      <a href="/" onclick="toggleNavMenu()" class="hover:text-red-600 transition-colors py-1">Home</a>
      <a href="/services/" onclick="toggleNavMenu()" class="hover:text-red-600 transition-colors py-1">Services</a>
      <a href="/about/" onclick="toggleNavMenu()" class="hover:text-red-600 transition-colors py-1">About</a>
      <a href="/contact/" onclick="toggleNavMenu()" class="hover:text-red-600 transition-colors py-1">Contact</a>
    </div>

    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2.5">
      <a 
        href={business.phoneHref} 
        class="w-full py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-center font-bold text-sm flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        <span>Call {business.phone}</span>
      </a>
      <a 
        href="/contact/" 
        onclick="toggleNavMenu()" 
        class="w-full py-2.5 rounded-xl text-white text-center font-semibold text-sm shadow-md"
        style="background: linear-gradient(135deg, #DC2626 0%, #EA580C 100%);"
      >
        Contact Us
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function toggleNavMenu() {
    const menu = document.getElementById('site-nav-mobile');
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }
</script>
