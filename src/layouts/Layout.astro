---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Reboot Computer Repairs', description = 'Fast computer repairs in Brisbane. Same-day service, no call-out fees.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://rebootyourcomputer.com.au">
    <meta property="og:locale" content="en_AU">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://rebootyourcomputer.com.au">
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">
          <span class="word">Reboot Your Computer</span>
          <span class="tagline">Fast Repairs Brisbane</span>
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/services/">Services</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
        <div class="header-cta">
          <a href="/contact/" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-size: 0.95rem;">Contact Us</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-content">
          <div class="footer-section">
            <h4>Contact</h4>
            <p><a href="/contact/">Phone &amp; enquiry form</a></p>
            <p>Email: <a href="mailto:info@rebootyourcomputer.com.au">info@rebootyourcomputer.com.au</a></p>
          </div>
          <div class="footer-section">
            <h4>Services</h4>
            <p><a href="/services/#virus-removal">Virus & Malware Removal</a></p>
            <p><a href="/services/#data-recovery">Data Recovery</a></p>
            <p><a href="/services/#hardware-repair">Hardware Repair</a></p>
            <p><a href="/services/#setup">Computer Setup</a></p>
          </div>
          <div class="footer-section">
            <h4>Company</h4>
            <p><a href="/about/">About Us</a></p>
            <p><a href="/contact/">Contact</a></p>
            <p><a href="/privacy/">Privacy Policy</a></p>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2025 Reboot Your Computer. All rights reserved. Brisbane, Australia.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
