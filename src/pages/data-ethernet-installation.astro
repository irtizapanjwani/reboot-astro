---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
import { DATA_ETHERNET_FALLBACK as d } from '../data/data-ethernet-fallback';
---

<Layout
  title="Data & Ethernet Installation Brisbane | Reboot Computer Repairs"
  description="ACMA-licensed Cat6 and Cat6A data and ethernet cabling for homes and offices across Brisbane. Flush-mounted faceplates, tested connections, lifetime workmanship."
>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow" id="de-eyebrow">{d.eyebrow}</p>
      <h1 id="de-h1">{d.headline} <span id="de-highlight">{d.highlightedText}</span></h1>
      <p id="de-sub">{d.subheading}</p>
      <div class="hero-actions">
        <a href="#quote" class="btn btn-primary" id="de-cta">{d.ctaText}</a>
        <a href={business.phoneHref} class="btn btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <section class="services" style="padding-top: 4rem; padding-bottom: 4rem;">
    <div class="wrap" style="max-width: 800px; text-align: center;">
      <h2 id="de-info-heading">{d.infoHeading}</h2>
      <p id="de-info-body" style="color: var(--color-gray-600); font-size: 1.0625rem;">{d.infoBody}</p>
    </div>
  </section>

  <section class="pricing">
    <div class="wrap">
      <h2 id="de-comparison-heading">{d.comparisonHeading}</h2>
      <div class="compare-table-wrap">
        <table class="compare-table" id="de-comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th class="good">The Right Way</th>
              <th class="bad">The Alternative</th>
            </tr>
          </thead>
          <tbody id="de-comparison-rows">
            {d.comparisonRows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                <td class="good">{row.goodOption}</td>
                <td class="bad">{row.badOption}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="services">
    <div class="wrap">
      <h2>Popular Projects</h2>
      <div class="services-grid" id="de-projects-grid">
        {d.projects.map((p) => (
          <div class="service-card">
            <img class="service-icon" src={p.icon} alt={p.title} loading="lazy" />
            <h3>{p.title}</h3>
            <p>{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="why-us">
    <div class="wrap">
      <h2>Built to Last</h2>
      <div class="why-us-grid" id="de-trust-grid">
        {d.trustFeatures.map((f) => (
          <div class="why-us-item">
            <h3>{f.title}</h3>
            <p>{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="services">
    <div class="wrap">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list" id="de-faqs">
        {d.faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pricing" id="quote">
    <div class="wrap" style="max-width: 640px;">
      <h2>Get a Quote</h2>
      <form class="enquiry" method="POST" action={business.formAction} novalidate>
        <input type="hidden" name="access_key" value={business.web3formsAccessKey}>
        <input type="hidden" name="subject" value="Data & ethernet enquiry — rebootyourcomputer.com.au">
        <input type="hidden" name="redirect" value="https://www.rebootyourcomputer.com.au/data-ethernet-installation/?sent=1">

        <div class="field">
          <label for="de-service">Service Required</label>
          <select id="de-service" name="service" required>
            <option value="" disabled selected>Choose an option</option>
            {d.serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="de-name">Your name</label>
          <input id="de-name" name="name" type="text" autocomplete="name" required maxlength="100" placeholder="John Smith">
        </div>

        <div class="field">
          <label for="de-phone">Phone</label>
          <input id="de-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="0401 234 567">
        </div>

        <div class="field">
          <label for="de-email">Email</label>
          <input id="de-email" name="email" type="email" autocomplete="email" maxlength="120" placeholder="you@example.com">
          <p class="hint">A phone number or an email address, whichever suits.</p>
        </div>

        <div class="field">
          <label for="de-suburb">Suburb</label>
          <input id="de-suburb" name="suburb" type="text" autocomplete="address-level2" maxlength="80" placeholder="e.g. Sunnybank">
        </div>

        <div class="field">
          <label for="de-details">Issue / Details</label>
          <textarea id="de-details" name="message" required maxlength="4000" placeholder="Tell us about the job."></textarea>
        </div>

        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">

        <button type="submit" class="btn btn-primary">Send</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="cta-banner">
    <div class="wrap">
      <h2 id="de-cta-heading">{d.ctaHeading}</h2>
      <p id="de-cta-sub">{d.ctaSubheading}</p>
      <a href="#quote" class="btn btn-secondary cta-invert">Get a Free Quote</a>
    </div>
  </section>

  <script src="/cms-fetch-data-ethernet.js" defer></script>
</Layout>

<style>
  .eyebrow {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
    margin-bottom: 0.75rem;
  }

  .compare-table-wrap {
    overflow-x: auto;
    margin-top: 2rem;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .compare-table th,
  .compare-table td {
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid var(--color-gray-200);
    font-size: 0.95rem;
  }

  .compare-table th {
    background: var(--color-gray-50);
    font-family: var(--font-display);
  }

  .compare-table th.good,
  .compare-table td.good {
    color: #15803d;
  }

  .compare-table th.bad,
  .compare-table td.bad {
    color: var(--color-gray-600);
  }

  .service-icon {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-item h3 {
    color: var(--color-red);
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    color: var(--color-gray-600);
    margin: 0;
  }

  .enquiry {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-gray-900);
    background: var(--color-white);
  }

  .field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 1px;
    border-color: var(--color-red);
  }

  .hint {
    color: var(--color-gray-600);
    font-size: 0.85rem;
    margin: 0;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    margin: 0;
    font-size: 0.9375rem;
    min-height: 1.4em;
  }

  .form-status[data-state='error'] {
    color: var(--color-red-dark);
  }

  .form-status[data-state='ok'] {
    color: #15803d;
    font-weight: 500;
  }

  .enquiry[data-sending] button {
    opacity: 0.6;
    pointer-events: none;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.enquiry');
  const status = document.querySelector<HTMLParagraphElement>('.form-status');

  if (status && new URLSearchParams(location.search).get('sent') === '1') {
    status.dataset.state = 'ok';
    status.textContent = 'Thanks — we have got that and will be in touch.';
    history.replaceState(null, '', location.pathname);
  }

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();

      const problems: string[] = [];
      if (!name) problems.push('your name');
      if (!phone && !email) problems.push('a phone number or email');
      if (!message) problems.push('what you need done');

      if (problems.length) {
        status.dataset.state = 'error';
        status.textContent = `We still need ${problems.join(', ')}.`;
        return;
      }

      form.dataset.sending = 'true';
      status.dataset.state = '';
      status.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { accept: 'application/json' },
        });
        const body = await res.json().catch(() => ({}));

        if (res.ok && body.success) {
          form.reset();
          status.dataset.state = 'ok';
          status.textContent = 'Thanks — we have got that and will be in touch.';
        } else {
          status.dataset.state = 'error';
          status.textContent = body.message || 'Something went wrong. Please call us instead.';
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'Could not reach us just now. Please call instead.';
      } finally {
        delete form.dataset.sending;
      }
    });
  }
</script>
