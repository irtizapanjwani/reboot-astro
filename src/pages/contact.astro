---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Reboot Your Computer" description="Get in touch with Reboot Computer Repairs. Call 07 3155 2002 or fill out our contact form.">
  <section style="padding: 4rem 2rem; background: linear-gradient(180deg, #f9fafb 0%, #fff 100%);">
    <div class="wrap">
      <h1 style="text-align: center; margin-bottom: 1rem;">Contact Us</h1>
      <p style="text-align: center; font-size: 1.125rem; color: #6b7280; max-width: 700px; margin: 0 auto;">
        Get in touch for a free quote or to book your repair appointment.
      </p>
    </div>
  </section>

  <section style="padding: 4rem 2rem;">
    <div class="wrap">
      <div style="max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">

        <div>
          <h2 style="margin-bottom: 2rem;">Get in Touch</h2>
          <div style="margin-bottom: 2.5rem;">
            <h3 style="color: #DC2626; font-size: 1.125rem; margin-bottom: 0.5rem;">Phone</h3>
            <a href="tel:+61731552002" style="font-size: 1.25rem; font-weight: 600; color: #DC2626;">07 3155 2002</a>
            <p style="color: #6b7280; font-size: 0.95rem; margin-top: 0.5rem;">Available Monday–Friday, 9am–5pm. Same-day repairs most cases.</p>
          </div>

          <div style="margin-bottom: 2.5rem;">
            <h3 style="color: #DC2626; font-size: 1.125rem; margin-bottom: 0.5rem;">Email</h3>
            <a href="mailto:info@rebootyourcomputer.com.au" style="font-size: 1.125rem; color: #DC2626;">info@rebootyourcomputer.com.au</a>
            <p style="color: #6b7280; font-size: 0.95rem; margin-top: 0.5rem;">We'll get back to you within 24 hours.</p>
          </div>

          <div style="margin-bottom: 2.5rem;">
            <h3 style="color: #DC2626; font-size: 1.125rem; margin-bottom: 0.5rem;">Service Area</h3>
            <p style="color: #6b7280;">Brisbane and surrounding suburbs. Free call-out within 15km of city center.</p>
          </div>

          <div style="background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%); padding: 1.5rem; border-radius: 0.75rem; border-left: 4px solid #DC2626;">
            <h4 style="margin-bottom: 0.5rem;">Hours</h4>
            <p style="color: #6b7280; font-size: 0.95rem;">Monday–Friday: 9am–5pm<br/>Saturday: 10am–2pm<br/>Sunday: Closed</p>
          </div>
        </div>

        <div>
          <h2 style="margin-bottom: 2rem;">Quick Inquiry</h2>
          <form style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Your Name</label>
              <input type="text" placeholder="John Smith" style="width: 100%; padding: 0.75rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; font-family: inherit;">
            </div>

            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Phone</label>
              <input type="tel" placeholder="0401 234 567" style="width: 100%; padding: 0.75rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; font-family: inherit;">
            </div>

            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Email</label>
              <input type="email" placeholder="your@email.com" style="width: 100%; padding: 0.75rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; font-family: inherit;">
            </div>

            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">What's Wrong?</label>
              <textarea placeholder="Describe your computer problem..." style="width: 100%; padding: 0.75rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; font-family: inherit; min-height: 120px; resize: vertical;"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem;">Send Inquiry</button>
          </form>
          <p style="color: #6b7280; font-size: 0.85rem; margin-top: 1rem;">We'll respond within 24 hours with a quote and appointment options.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="wrap">
      <h2>Or Call Us Now</h2>
      <p>Quick quote over the phone. No obligation.</p>
      <a href="tel:+61731552002" class="btn btn-secondary" style="color: var(--color-white); border-color: var(--color-white);">07 3155 2002</a>
    </div>
  </section>
</Layout>
