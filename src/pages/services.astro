---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
---

<Layout title="Services - Reboot Your Computer" description="Computer repair services in Brisbane. Virus removal, data recovery, hardware repair, and software setup.">
  <section style="padding: 4rem 2rem; background: linear-gradient(180deg, #f9fafb 0%, #fff 100%);">
    <div class="wrap">
      <h1 style="text-align: center; margin-bottom: 1rem;">Our Services</h1>
      <p style="text-align: center; font-size: 1.125rem; color: #6b7280; max-width: 700px; margin: 0 auto 4rem;">
        Expert computer repair for every issue. Fast diagnosis, transparent pricing, same-day service.
      </p>
    </div>
  </section>

  <section style="padding: 4rem 2rem;">
    <div class="wrap">
      <div style="max-width: 800px; margin: 0 auto;">

        <div style="margin-bottom: 4rem;">
          <h2 style="color: #DC2626; margin-bottom: 1rem;">🛡️ Virus & Malware Removal</h2>
          <p>Is your computer running slow? Full of pop-ups? Threatened by antivirus warnings? We remove malware completely.</p>
          <ul style="margin: 1.5rem 0; padding-left: 1.5rem; color: #6b7280;">
            <li style="margin-bottom: 0.75rem;">Complete infection removal — root to tip</li>
            <li style="margin-bottom: 0.75rem;">Security hardening and protection setup</li>
            <li style="margin-bottom: 0.75rem;">Safe mode repairs for severe infections</li>
            <li style="margin-bottom: 0.75rem;">Same-day turnaround, most cases</li>
          </ul>
          <p><strong>Price:</strong> Charged at our standard rates below. No fix, no fee.</p>
        </div>

        <div style="margin-bottom: 4rem;">
          <h2 style="color: #DC2626; margin-bottom: 1rem;">💾 Data Recovery</h2>
          <p>Hard drive died? Photos lost? Deleted important files? We recover data from failed and dead drives.</p>
          <ul style="margin: 1.5rem 0; padding-left: 1.5rem; color: #6b7280;">
            <li style="margin-bottom: 0.75rem;">Dead and failing drive recovery</li>
            <li style="margin-bottom: 0.75rem;">Corrupted partition repair</li>
            <li style="margin-bottom: 0.75rem;">Accidental deletion recovery</li>
            <li style="margin-bottom: 0.75rem;">Professional-grade recovery tools</li>
          </ul>
          <p><strong>Price:</strong> Charged at our standard rates below. No fix, no fee.</p>
        </div>

        <div style="margin-bottom: 4rem;">
          <h2 style="color: #DC2626; margin-bottom: 1rem;">🔧 Hardware Repair</h2>
          <p>Broken screen? Dead battery? Faulty port? We fix hardware issues on desktops and laptops.</p>
          <ul style="margin: 1.5rem 0; padding-left: 1.5rem; color: #6b7280;">
            <li style="margin-bottom: 0.75rem;">Laptop and desktop screen replacement</li>
            <li style="margin-bottom: 0.75rem;">Battery replacement and repair</li>
            <li style="margin-bottom: 0.75rem;">Charging port and USB repair</li>
            <li style="margin-bottom: 0.75rem;">Keyboard and component replacement</li>
          </ul>
          <p><strong>Price:</strong> Labour at our standard rates below, plus parts. Quoted before we start.</p>
        </div>

        <div style="margin-bottom: 4rem;">
          <h2 style="color: #DC2626; margin-bottom: 1rem;">⚙️ Software Setup & Migration</h2>
          <p>New computer? Old system sluggish? We set up, configure, and migrate your data safely.</p>
          <ul style="margin: 1.5rem 0; padding-left: 1.5rem; color: #6b7280;">
            <li style="margin-bottom: 0.75rem;">New computer setup and configuration</li>
            <li style="margin-bottom: 0.75rem;">Data migration from old to new system</li>
            <li style="margin-bottom: 0.75rem;">Software installation and licensing</li>
            <li style="margin-bottom: 0.75rem;">Windows updates and system optimization</li>
          </ul>
          <p><strong>Price:</strong> Charged at our standard rates below. No fix, no fee.</p>
        </div>

        <div style="margin-bottom: 4rem; background: #f9fafb; padding: 2rem; border-radius: 0.75rem; border-left: 4px solid #DC2626;">
          <h2 style="color: #DC2626; margin-bottom: 1rem;">Our Rates</h2>
          <p><strong>Workshop repairs</strong> — {business.rates.workshop.price} {business.rates.workshop.unit}.</p>
          <p><strong>On site service</strong> — {business.rates.onsite.price} {business.rates.onsite.unit}.</p>
          <p><strong>Remote service</strong> — {business.rates.remote.price} {business.rates.remote.unit}.</p>
          <p style="margin-bottom: 0; color: #6b7280;">No call out fees, no travel fees, no hidden charges. Open 7 AM to 10 PM every day, including public holidays, with no surcharge.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="wrap">
      <h2>Need Help? Contact Us Today</h2>
      <p>Call for a free quote or to book your repair appointment.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact/" class="btn btn-secondary" style="color: var(--color-white); border-color: var(--color-white);">Book Now</a>
      </div>
    </div>
  </section>
</Layout>
