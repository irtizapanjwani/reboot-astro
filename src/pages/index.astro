---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reboot Your Computer - Fast Computer Repairs Brisbane" description="Expert computer repairs in Brisbane. Same-day service, no call-out fees. Virus removal, data recovery, hardware repair.">
  <section class="hero">
    <div class="hero-content">
      <h1>Fast Computer Repairs<br/>Brisbane & Surrounds</h1>
      <p>Expert technicians. Same-day service. No call-out fees. We fix it right the first time.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact/" class="btn btn-primary">Book a Repair</a>
        <a href="/contact/" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>
  </section>

  <section class="services">
    <div class="wrap">
      <h2>What We Fix</h2>
      <div class="services-grid">
        <div class="service-card">
          <h3>🛡️ Virus & Malware</h3>
          <p>Infected systems cleaned and hardened. Security installed. Protection configured. Same-day results.</p>
        </div>
        <div class="service-card">
          <h3>💾 Data Recovery</h3>
          <p>Failed hard drives restored. Photos, documents, everything recovered. Professional-grade recovery.</p>
        </div>
        <div class="service-card">
          <h3>🔧 Hardware Repair</h3>
          <p>Screen replacements. Battery swaps. Port repairs. All brands, all faults. Same-day turnaround.</p>
        </div>
        <div class="service-card">
          <h3>⚙️ Software Setup</h3>
          <p>New computers configured from scratch. Old systems migrated. Everything runs perfectly.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="why-us">
    <div class="wrap">
      <h2>Why Choose Reboot?</h2>
      <div class="why-us-grid">
        <div class="why-us-item">
          <h3>Same-Day Service</h3>
          <p>Most repairs completed while you wait. Same-day turnaround on almost everything. No lengthy waits.</p>
        </div>
        <div class="why-us-item">
          <h3>No Call-Out Fees</h3>
          <p>Honest pricing. You only pay for what we fix. No hidden charges or surprise fees.</p>
        </div>
        <div class="why-us-item">
          <h3>Expert Technicians</h3>
          <p>Certified professionals with years of experience. We know every major brand and every fault type.</p>
        </div>
        <div class="why-us-item">
          <h3>Warranty Coverage</h3>
          <p>All repairs backed by warranty. Fix it once, fix it right. Your satisfaction guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="wrap">
      <h2>Computer Playing Up?</h2>
      <p>Tell us what's wrong and we'll get back to you the same day with a price to fix it.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact/" class="btn btn-secondary" style="color: var(--color-white); border-color: var(--color-white);">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>
