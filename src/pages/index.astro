---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
import home from '../content/home/index.json';
import PhoneMark from '../components/PhoneMark.astro';
import { serviceMark } from '../data/service-marks';

// Metadata mirrors the live WordPress homepage exactly — see SEO-BASELINE.md.
// This page ranks position 8.7 for "computer repairs brisbane"; do not change
// the title, description, H1 or canonical without checking that file first.
// The phone number is interpolated from config so it has one home.
// The H1/hero copy below is editorial and lives in src/content/home/index.json
// (edit visually via `npm run tina:dev`), NOT here — SEO metadata stays as-is.
const seoTitle = 'Reboot Computer Repairs Brisbane - Reboot Computer Repairs';
const seoDescription = `Computer Repairs Brisbane - On-site, expert and affordable solutions for your PC, Mac & laptop repair needs. We provide quick and reliable repairs and services anywhere in Brisbane. We are open everyday from 7 AM to 10 PM even on holidays. Give us a call at ${business.phone} with no call out fees!`;

const pricing = [
  {
    name: 'Workshop Repairs',
    note: 'Open 7 AM to 10 PM',
    price: business.rates.workshop.price,
    unit: business.rates.workshop.unit,
    points: [
      'No call out fees',
      'No hidden charges',
      'No fix, no fee',
      'Fix any computer problem',
      'Most repairs are done in 1 hour',
      'Expert technical support',
    ],
  },
  {
    name: 'On Site Service',
    note: 'Best value',
    price: business.rates.onsite.price,
    unit: business.rates.onsite.unit,
    points: [
      'No call out fees',
      'No travel fees',
      'No hidden charges',
      'No fix, no fee',
      'Fix any computer problem',
      'Most repairs are done in 1 hour',
      'Expert technical support',
    ],
  },
  {
    name: 'Remote Service',
    note: 'For easy to fix PC problems',
    price: business.rates.remote.price,
    unit: business.rates.remote.unit,
    points: [
      'No call out fees',
      'No hidden charges',
      'Download special software',
      'Fix computer problems remotely',
      'Most repairs are done in 1 hour',
      'Expert technical support',
    ],
  },
];

// "Not sure what's wrong?" section. `fallback` is where each tile links when
// JS is off: the matching "What We Fix" card.
//
// TODO: cause, price and time are PLACEHOLDER copy. Replace with the client's
// real figures before launch. Prices must stay consistent with the hourly
// rates in src/config/business.ts.
const symptoms = [
  {
    slug: 'wont-turn-on', label: "Won't turn on", fallback: '#service-laptop-mac-hardware',
    cause: 'Usually a dead charger, battery or power supply. Less often, the motherboard.',
    price: '$150–$350', time: 'Same visit, or 1–2 days if a part is needed',
  },
  {
    slug: 'slow', label: 'Running slow', fallback: '#what-we-fix',
    cause: 'A full or failing drive, too much starting up with Windows, or something running in the background.',
    price: '$150–$250', time: '1–2 hours',
  },
  {
    slug: 'virus', label: 'Virus or pop-ups', fallback: '#service-virus-malware',
    cause: 'Adware or malware, usually from a fake download, email link or browser extension.',
    price: '$150–$225', time: '1–2 hours',
  },
  {
    slug: 'screen', label: 'Broken screen', fallback: '#service-laptop-mac-hardware',
    cause: 'A cracked or failed panel. We confirm the exact part for your model, then order it in.',
    price: '$200–$450', time: '1–3 days, depending on the part',
  },
  {
    slug: 'data', label: 'Lost files', fallback: '#service-data-recovery',
    cause: 'Accidental deletion or a failing drive. Stop using the machine now. Every use lowers the odds.',
    price: '$150–$600', time: 'Same day to a week',
  },
  {
    slug: 'internet', label: 'Wi-Fi & internet', fallback: '#what-we-fix',
    cause: 'Usually router placement, settings or an out-of-date network driver, not your internet plan.',
    price: '$150–$190', time: 'About an hour',
  },
];

// Names for the laptop parts a service can light up in "What we fix".
const partNames: Record<string, string> = {
  screen: 'screen', board: 'motherboard', drive: 'drive', battery: 'battery', wifi: 'Wi-Fi', ports: 'ports',
};

// Anchor ids for the "What We Fix" cards, so the no-JS keycaps have somewhere to land.
const serviceId = (title: string) =>
  'service-' + title.toLowerCase().replace(/&/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');


// "first hour, then $37.50 per 15 minutes" -> "then $37.50 per 15 minutes"
const onsiteAfter = business.rates.onsite.unit.replace(/^first hour,\s*/, '');

---

<Layout title={seoTitle} description={seoDescription}>
  <section class="home-hero">
    <div class="hero-stage">
      <div class="hero-red" aria-hidden="true"></div>

      <div class="hero-msg">
        <!-- The H1 is locked to "Computer Repairs Brisbane" (SEO-BASELINE.md). -->
        <h1 class="home-hero-kicker">Computer Repairs Brisbane</h1>
        <p class="home-hero-title"><span class="nowrap">On-site</span> computer repairs across Brisbane</p>
        <p class="home-hero-sub">Expert PC, Mac and laptop repairs at your home or office. Open every day, 7AM to 10PM.</p>
      </div>

      <div class="hero-offer">
        <div class="offer-price">
          <p class="offer-figure">{business.rates.onsite.price}</p>
          <p class="offer-label">first hour, <span class="nowrap">on-site</span><br /><span class="offer-note">{onsiteAfter}</span></p>
        </div>
        <a href={business.phoneHref} class="btn btn-call btn-call-lg btn-on-red">
          <PhoneMark />
          <span>{business.phone}</span>
        </a>
        <p class="offer-status" data-open-status data-opens={business.hours.opens} data-closes={business.hours.closes}>
          <span data-open-text></span>
        </p>
      </div>

      <!-- All four are claims the live site already makes (pricing tiers, Why Us). -->
      <ul class="hero-terms">
        <li><strong>$0</strong> call-out fee</li>
        <li><strong>No fix,</strong> no fee</li>
        <li><strong>No surcharge</strong> on weekends, holidays or late nights</li>
        <li><strong>Most repairs</strong> done within the hour</li>
      </ul>

      <!-- Right-hand panel: real facts from config and the Why Us copy. -->
      <aside class="hero-aside" aria-label="Where we work">
        <p class="aside-title">We come to you</p>
        <ul class="aside-areas">
          {business.areasServed.map((area) => <li>{area}</li>)}
        </ul>
        <p class="aside-note"><strong>As seen on Channel 9</strong>Interviewed about slow internet speeds around Brisbane.</p>
      </aside>

      <!-- Posts to Web3Forms. While the other pages are switched off, Web3Forms
           sends people back here with ?sent=1 and the form shows a thank-you. -->
      <form class="hero-form" id="quote" action={business.formAction} method="POST" aria-labelledby="hero-form-title">
        <input type="hidden" name="access_key" value={business.web3formsAccessKey} />
        <input type="hidden" name="subject" value="Quote request (homepage) — rebootyourcomputer.com.au" />
        <input type="hidden" name="redirect" value={`${business.site}/?sent=1#quote`} data-redirect />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />

        <div class="form-head">
          <h2 id="hero-form-title">Get a free quote</h2>
          <!-- TODO: confirm reply time with the client. -->
          <p>Usually replies within 15 minutes</p>
        </div>
        <!-- TODO: confirm with the client. -->
        <p class="form-proof">Takes 30 seconds &middot; No obligation</p>

        <div class="field-row">
          <label class="field">
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" required maxlength="100" />
          </label>
          <label class="field">
            <span>Phone</span>
            <input name="phone" type="tel" autocomplete="tel" required maxlength="40" />
          </label>
        </div>
        <label class="field">
          <span>Suburb</span>
          <select name="suburb" required>
            <option value="" disabled selected>Choose your area</option>
            {business.areasServed.map((area) => <option>{area}</option>)}
            <option>Somewhere else</option>
          </select>
        </label>
        <label class="field">
          <span>What&rsquo;s the problem?</span>
          <textarea name="message" rows="2" required maxlength="4000" placeholder="Won't turn on after a drink spill"></textarea>
        </label>

        <button type="submit" class="btn btn-call form-submit">Get my free quote</button>
        <!-- TODO: confirm warranty terms with the client before launch. -->
        <p class="form-proof form-proof-end">1-year warranty on all repairs</p>

        <div class="form-thanks" role="status" hidden>
          <h2>Thanks, we&rsquo;ve got it</h2>
          <p>We&rsquo;ll be in touch about your quote. If it&rsquo;s urgent, call <a href={business.phoneHref}>{business.phone}</a>.</p>
        </div>
      </form>

      <script>
        // Return to whichever host the form was sent from (preview or live),
        // and show the thank-you after Web3Forms redirects back with ?sent=1.
        const form = document.getElementById('quote');
        const redirect = form?.querySelector<HTMLInputElement>('[data-redirect]');
        if (redirect) redirect.value = `${location.origin}/?sent=1#quote`;
        if (form && new URLSearchParams(location.search).get('sent') === '1') {
          Array.from(form.children).forEach((el) => {
            if (el instanceof HTMLElement && !el.classList.contains('form-thanks') && el.tagName !== 'INPUT') el.hidden = true;
          });
          form.querySelector<HTMLElement>('.form-thanks')?.removeAttribute('hidden');
        }
      </script>
    </div>
  </section>

  <section class="intro">
    <div class="wrap">
      <p>{home.introBody}</p>
    </div>
  </section>

  <section class="diagnose" id="diagnose">
    <div class="wrap diag-layout">
      <div class="diag-side">
        <h2>Not sure what&rsquo;s wrong?</h2>
        <p class="diagnose-lead">Tell us what it&rsquo;s doing and we&rsquo;ll run a quick diagnosis: the likely cause, roughly what it costs and how long it takes.</p>
        <ul class="symptom-list">
          {symptoms.map((sym, i) => (
            <li>
              <a href={sym.fallback} class="symptom" data-symptom={sym.slug}>
                <span class="symptom-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="symptom-label">{sym.label}</span>
                <span class="symptom-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- A laptop drawn in CSS; its screen prints the diagnosis. -->
      <div class="laptop">
        <div class="laptop-lid">
          <div class="laptop-screen" id="diag-screen">
            <div class="screen-bar">
              <span>reboot diagnostics</span>
              <span data-open-status data-opens={business.hours.opens} data-closes={business.hours.closes}><span data-open-text></span></span>
            </div>
            <div class="screen-body" aria-live="polite">
              <div class="screen-idle">
                <p class="screen-prompt">&gt; waiting for symptom<span class="caret" aria-hidden="true"></span></p>
                <p class="screen-hint">Pick what you&rsquo;re seeing. Most repairs are done within the hour.</p>
              </div>
              {symptoms.map((sym) => (
                <div class="screen-answer" data-answer={sym.slug} hidden>
                  <p class="screen-line"><span class="screen-key">symptom</span><span>{sym.label}</span></p>
                  <p class="screen-line"><span class="screen-key">likely cause</span><span>{sym.cause}</span></p>
                  <p class="screen-line"><span class="screen-key">typical cost</span><strong>{sym.price}</strong></p>
                  <p class="screen-line"><span class="screen-key">turnaround</span><span>{sym.time}</span></p>
                  <div class="screen-actions">
                    <a href={business.phoneHref} class="btn btn-call">
                      <PhoneMark />
                      <span>{business.phone}</span>
                    </a>
                    <a href="#quote" class="link-quote">Get a free quote</a>
                  </div>
                  <p class="screen-small">Estimate only. We confirm the price before any work starts.</p>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="laptop-base" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <script>
    // Without JS the symptoms are plain links to the "What We Fix" cards.
    // With JS they print the matching diagnosis on the laptop screen.
    const screen = document.getElementById('diag-screen');
    const symptoms = Array.from(document.querySelectorAll<HTMLAnchorElement>('.symptom'));
    const idle = screen?.querySelector<HTMLElement>('.screen-idle');
    const answers = Array.from(screen?.querySelectorAll<HTMLElement>('.screen-answer') ?? []);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    symptoms.forEach((link) => {
      link.setAttribute('role', 'button');
      link.setAttribute('aria-pressed', 'false');
      link.setAttribute('aria-controls', 'diag-screen');

      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.dataset.symptom;
        symptoms.forEach((l) => l.setAttribute('aria-pressed', String(l === link)));
        if (idle) idle.hidden = true;
        answers.forEach((a) => (a.hidden = a.dataset.answer !== slug));

        // On stacked layouts the screen sits below the list; bring it into view.
        const rect = screen?.getBoundingClientRect();
        if (screen && rect && (rect.top < 0 || rect.bottom > window.innerHeight)) {
          screen.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'center' });
        }
      });

      // Space should press a role=button link too.
      link.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          link.click();
        }
      });
    });
  </script>

  <!-- Sections below use home-* classes so the Services page, which shares
       .services-grid and .cta-banner, keeps its own look. -->
  <section class="home-fix" id="what-we-fix">
    <div class="wrap">
      <h2 class="fix-heading">What we fix</h2>
      <p class="fix-lead">PCs, Macs and laptops, at your place or ours. If we can&rsquo;t fix it, you don&rsquo;t pay.</p>

      <!-- Switchboard: tabs on wide screens, accordion on phones, and every
           panel stacked and readable without JS. Works with any number of
           services from the CMS. -->
      <div class="fix-switch" data-fix-switch>
        <div class="fix-tabs" role="tablist" aria-label="What's wrong?" aria-orientation="vertical">
          {home.services.map((service, i) => (
            <button
              type="button"
              class="fix-tab"
              role="tab"
              id={`fix-tab-${i}`}
              aria-controls={serviceId(service.title)}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="fix-tab-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d={serviceMark(service.title)} /></svg>
              </span>
              <span class="fix-tab-text">
                <span class="fix-tab-title">{service.symptom ?? service.title}</span>
                <span class="fix-tab-sub">{service.title}</span>
              </span>
              <span class="fix-tab-arrow" aria-hidden="true">&rarr;</span>
            </button>
          ))}
        </div>

        <div class="fix-panels">
          <!-- Laptop x-ray, drawn in SVG. The script lights up the parts listed
               on the selected service; without JS it stays hidden. -->
          <svg class="xray" viewBox="0 0 600 340" aria-hidden="true">
            <rect class="xray-shell" x="110" y="6" width="380" height="204" rx="14" />
            <g class="xray-part" data-part="screen">
              <rect x="124" y="20" width="352" height="176" rx="5" />
              <path class="xray-detail" d="M150 46h120M150 62h86M150 78h104" />
            </g>
            <rect class="xray-shell" x="92" y="212" width="416" height="8" rx="4" />
            <rect class="xray-shell" x="60" y="224" width="480" height="108" rx="14" />
            <g class="xray-part" data-part="wifi">
              <rect x="84" y="242" width="58" height="32" rx="3" />
              <path class="xray-detail" d="M97 262a16 16 0 0 1 32 0M104 262a9 9 0 0 1 18 0" />
            </g>
            <g class="xray-fan">
              <circle cx="186" cy="262" r="23" />
              <path d="M186 262l0-17M186 262l15 9M186 262l-15 9" />
            </g>
            <g class="xray-part" data-part="board">
              <rect x="226" y="238" width="152" height="54" rx="3" />
              <rect class="xray-detail" x="240" y="248" width="30" height="30" rx="2" />
              <rect class="xray-detail" x="280" y="248" width="42" height="14" rx="2" />
              <rect class="xray-detail" x="280" y="268" width="20" height="12" rx="2" />
              <rect class="xray-detail" x="332" y="248" width="34" height="32" rx="2" />
            </g>
            <g class="xray-part" data-part="drive">
              <rect x="394" y="242" width="122" height="36" rx="3" />
              <path class="xray-detail" d="M406 260h56M474 252v16M482 252v16M490 252v16M498 252v16" />
            </g>
            <g class="xray-part" data-part="battery">
              <rect x="84" y="298" width="432" height="22" rx="3" />
              <path class="xray-detail" d="M192 298v22M300 298v22M408 298v22" />
            </g>
            <g class="xray-part" data-part="ports">
              <rect x="54" y="246" width="10" height="14" rx="2" />
              <rect x="54" y="268" width="10" height="10" rx="2" />
              <rect x="536" y="246" width="10" height="14" rx="2" />
            </g>
          </svg>

          {home.services.map((service, i) => (
            <div class:list={['fix-panel', { 'is-active': i === 0 }]} id={serviceId(service.title)} data-index={i} data-parts={(service.parts ?? []).join(' ')}>
              <h3 class="fix-acc-head">
                <button type="button" class="fix-acc-btn" aria-controls={`fix-body-${i}`}>{service.symptom ?? service.title}</button>
              </h3>
              <div class="fix-panel-body" id={`fix-body-${i}`}>
                <div class="fix-detail">
                  <p class="fix-label">{service.title}</p>
                  <p class="fix-body">{service.body}</p>
                  {service.parts?.length > 0 && (
                    <p class="fix-where">Where we look: {service.parts.map((part) => partNames[part] ?? part).join(', ')}</p>
                  )}
                  <p class="fix-actions">
                    <a href="#quote">Get a quote for this</a>
                    <span>or call</span>
                    <a href={business.phoneHref}>{business.phone}</a>
                  </p>
                </div>
                {service.points?.length > 0 && (
                  <ul class="fix-points">
                    {service.points.map((point) => <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.2 10.6l3.6 3.5 8-8.4"/></svg>{point}</li>)}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- One rate for every service. All figures come from business.ts. -->
      <p class="fix-rate-line">
        <span><strong>{business.rates.onsite.price}</strong> {business.rates.onsite.unit.replace('first hour', 'first hour on-site')}</span>
        <span aria-hidden="true">&middot;</span>
        <span><strong>{business.callOutFee}</strong> call-out</span>
        <span aria-hidden="true">&middot;</span>
        <span>{business.typicalRepair}</span>
      </p>
    </div>
  </section>

  <script>
    // Tabs on wide screens, accordion on phones. Without JS none of this runs:
    // the tab list stays hidden and every panel shows in full.
    const root = document.querySelector<HTMLElement>('[data-fix-switch]');
    if (root) {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.fix-tab'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.fix-panel'));
      const accButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.fix-acc-btn'));
      const phone = window.matchMedia('(max-width: 760px)');
      let active = 0;

      const select = (i: number, focus = false) => {
        active = i;
        tabs.forEach((tab, t) => {
          tab.setAttribute('aria-selected', String(t === i));
          tab.tabIndex = t === i ? 0 : -1;
        });
        panels.forEach((panel, p) => panel.classList.toggle('is-active', p === i));
        root.dataset.parts = panels[i].dataset.parts ?? '';
        if (focus) tabs[i].focus();
      };

      const setMode = () => {
        const accordion = phone.matches;
        root.dataset.mode = accordion ? 'accordion' : 'tabs';
        panels.forEach((panel, p) => {
          const body = panel.querySelector<HTMLElement>('.fix-panel-body');
          if (accordion) {
            panel.removeAttribute('role');
            panel.removeAttribute('aria-labelledby');
            panel.removeAttribute('tabindex');
            const open = p === active;
            accButtons[p].setAttribute('aria-expanded', String(open));
            if (body) body.hidden = !open;
          } else {
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', `fix-tab-${p}`);
            panel.tabIndex = 0;
            if (body) body.hidden = false;
          }
        });
        select(active);
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('mouseenter', () => select(i));
        tab.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: last }[e.key];
          if (next === undefined) return;
          e.preventDefault();
          select((next + tabs.length) % tabs.length, true);
        });
      });

      accButtons.forEach((btn, i) => {
        btn.addEventListener('click', () => {
          const body = panels[i].querySelector<HTMLElement>('.fix-panel-body');
          const open = btn.getAttribute('aria-expanded') !== 'true';
          btn.setAttribute('aria-expanded', String(open));
          if (body) body.hidden = !open;
          if (open) active = i;
        });
      });

      root.classList.add('is-ready');
      setMode();
      phone.addEventListener('change', setMode);
    }
  </script>

  <section class="home-section home-pricing">
    <div class="wrap">
      <div class="home-head">
        <h2>Upfront pricing</h2>
        <p>You choose the time and date. Weekends, public holidays and late nights, with no extra surcharges.</p>
      </div>
      <div class="price-grid">
        {pricing.map((tier) => (
          <div class={tier.name === 'On Site Service' ? 'price-card is-featured' : 'price-card'}>
            <p class="price-note">{tier.note}</p>
            <h3>{tier.name}</h3>
            <p class="price-amount"><strong>{tier.price}</strong><span>{tier.unit}</span></p>
            <ul>
              {tier.points.map((point) => <li>{point}</li>)}
            </ul>
            <a href="#quote" class="btn price-btn">Get a quote</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-why">
    <div class="wrap home-why-grid">
      <div class="home-why-intro">
        <h2>Why choose Reboot?</h2>
        <p>A local team that turns up when it suits you and tells you the price before starting.</p>
      </div>
      <ol class="why-list">
        {home.whyUs.map((item, i) => (
          <li>
            <span class="why-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-section home-cta-wrap">
    <div class="wrap">
      <div class="home-cta">
        <div class="home-cta-text">
          <h2>{home.ctaHeading}</h2>
          <p>{home.ctaBody}</p>
        </div>
        <div class="home-cta-actions">
          <a href={business.phoneHref} class="btn home-cta-call">
            <PhoneMark />
            <span>{business.phone}</span>
          </a>
          <a href="#quote" class="home-cta-link">or send us the details</a>
        </div>
